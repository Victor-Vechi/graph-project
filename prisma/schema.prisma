generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaVisibility {
  PUBLIC
  PRIVATE
}

enum MediaKind {
  IMAGE
  PDF
  DOCUMENT
  PRESENTATION
  ARCHIVE
  DATASET
  OTHER
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  active      Boolean  @default(true)

  users User[]

  @@map("roles")
}

model Tag {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  active      Boolean  @default(true)

  posts PostTag[]

  @@map("tags")
}

model User {
  id            Int          @id @default(autoincrement())
  name          String
  email         String       @unique
  password      String
  idRole        Int?
  searchArea    String?
  subjects      String?
  showUser      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  active        Boolean      @default(true)

  role          Role?        @relation(fields: [idRole], references: [id])
  posts         Post[]
  uploadedMedia MediaAsset[] @relation("MediaUploader")
  materials     Material[]   @relation("MaterialUploader")

  @@map("users")
}

model Post {
  id           Int         @id @default(autoincrement())
  title        String
  content      String
  userId       Int?
  coverMediaId String?     @unique
  coverAlt     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  active       Boolean     @default(true)

  user         User?       @relation(fields: [userId], references: [id])
  coverMedia   MediaAsset? @relation("PostCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  tags         PostTag[]

  @@map("posts")
}

model PostTag {
  id     Int @id @default(autoincrement())
  postId Int
  tagId  Int

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
  @@map("post_tags")
}

model MediaAsset {
  id           String          @id @default(cuid())
  bucket       String
  storageKey   String          @unique
  originalName String
  mimeType     String
  sizeBytes    BigInt
  checksum     String?
  etag         String?
  kind         MediaKind
  visibility   MediaVisibility
  uploadedById Int?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  uploadedBy   User?           @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  postCover    Post?           @relation("PostCover")
  material     Material?       @relation("MaterialFile")

  @@map("media_assets")
}

model Material {
  id           Int         @id @default(autoincrement())
  title        String
  description  String?
  category     String?
  year         Int?
  tags         String[]     @default([])
  mediaId      String       @unique
  uploadedById Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  active       Boolean      @default(true)

  media        MediaAsset   @relation("MaterialFile", fields: [mediaId], references: [id], onDelete: Restrict)
  uploadedBy   User?        @relation("MaterialUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@map("materials")
}
