// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaVisibility {
  PUBLIC
  PRIVATE
}

enum MediaKind {
  IMAGE
  PDF
  DOCUMENT
  PRESENTATION
  ARCHIVE
  DATASET
  OTHER
}

model Role {
  id        Int     @id @default(autoincrement())
  name      String
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  active    Boolean  @default(true)

  // Relations
  users User[]

  @@map("roles")
}

model Tag {
  id        Int     @id @default(autoincrement())
  name      String
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  active    Boolean  @default(true)

  // Relations
  posts PostTag[]

  @@map("tags")
}

model User {
  id          Int     @id @default(autoincrement())
  name        String
  email       String  @unique
  password    String
  idRole      Int?
  searchArea  String?
  subjects    String?
  showUser    Boolean @default(true)
  idInstitution Int?
  photoMediaId String? @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  active      Boolean  @default(true)

  // Relations
  role          Role?        @relation(fields: [idRole], references: [id])
  institution   Institution? @relation(fields: [idInstitution], references: [id])
  photoMedia    MediaAsset? @relation("UserPhoto", fields: [photoMediaId], references: [id], onDelete: SetNull)
  posts         Post[]
  uploadedMedia MediaAsset[] @relation("MediaUploader")
  materials     Material[]   @relation("MaterialUploader")
  postLogs      PostLog[]

  @@map("users")
}

model Institution {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  acronym   String?
  city      String?
  country   String?
  website   String?
  photoMediaId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  active    Boolean  @default(true)

  // Relations
  users User[]
  photoMedia MediaAsset? @relation("InstitutionPhoto", fields: [photoMediaId], references: [id], onDelete: SetNull)

  @@map("institutions")
}

model Post {
  id           Int         @id @default(autoincrement())
  title        String
  content      String
  userId       Int?
  coverMediaId String?     @unique
  coverAlt     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  active       Boolean     @default(true)

  // Relations
  user         User?       @relation(fields: [userId], references: [id])
  coverMedia   MediaAsset? @relation("PostCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  tags         PostTag[]
  logs         PostLog[]

  @@map("posts")
}

// Junction table for Post-Tag many-to-many relationship
model PostTag {
  id    Int @id @default(autoincrement())
  postId Int
  tagId  Int

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
  @@map("post_tags")
}

model MediaAsset {
  id           String          @id @default(cuid())
  originalName String
  mimeType     String
  sizeBytes    BigInt
  checksum     String?
  base64Data   String          @db.Text
  kind         MediaKind
  visibility   MediaVisibility
  uploadedById Int?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  uploadedBy   User?           @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  postCover    Post?           @relation("PostCover")
  material     Material?       @relation("MaterialFile")
  userPhoto    User?           @relation("UserPhoto")
  institutionPhoto Institution? @relation("InstitutionPhoto")

  @@map("media_assets")
}

model Material {
  id           Int        @id @default(autoincrement())
  title        String
  description  String?
  category     String?
  year         Int?
  tags         String[]   @default([])
  mediaId      String     @unique
  uploadedById Int?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  active       Boolean    @default(true)

  media        MediaAsset @relation("MaterialFile", fields: [mediaId], references: [id], onDelete: Restrict)
  uploadedBy   User?      @relation("MaterialUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@map("materials")
}

// Auditoria das notícias: quem criou, editou ou excluiu e o que mudou.
// postId/userId viram nulos se a notícia ou o usuário forem excluídos; os nomes ficam salvos no log.
model PostLog {
  id        Int      @id @default(autoincrement())
  postId    Int?
  userId    Int?
  action    String   // CREATE | UPDATE | DELETE
  postTitle String
  userName  String
  changes   String[] // campos alterados: title, content, tags
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  post Post? @relation(fields: [postId], references: [id], onDelete: SetNull)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([postId])
  @@index([userId])
  @@map("post_logs")
}
